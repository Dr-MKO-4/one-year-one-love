# Base de données (docker-compose local : port 5433)
DATABASE_URL="postgresql://love:love@localhost:5433/love?schema=public"

# Codes PIN (4 à 8 chiffres) : à changer avant la mise en ligne
MIGUEL_PIN="2203"
ADELE_PIN="1604"

# Secret de signature des sessions (chaîne longue et aléatoire)
JWT_SECRET="change-me-with-a-long-random-string"

# Dossier des fichiers audio de la playlist partagée.
# En local : laisser vide pour utiliser ./music. Sur Railway : /music (point de montage du volume).
# MUSIC_DIR=

# Port du serveur Express
PORT=4000

# development | production
NODE_ENV=development
